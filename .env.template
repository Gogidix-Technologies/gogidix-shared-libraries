# Development Environment Configuration
NODE_ENV=development
APP_ENV=development
DEBUG=true

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id

# Security Keys
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret
SESSION_SECRET=your_session_secret
CSRF_SECRET=your_csrf_secret
ENCRYPTION_KEY=your_encryption_key

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=exalt_ecommerce_dev
DATABASE_USER=exalt_user
DATABASE_PASSWORD=your_database_password
DATABASE_SSL=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TLS=false

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@exalt-application-limited.com
EMAIL_FROM_NAME=Exalt Application Limited

# Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Third-Party APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_TRANSLATOR_API_KEY=your_google_translator_api_key
DHL_API_KEY=your_dhl_api_key
DHL_API_SECRET=your_dhl_api_secret
FIXER_API_KEY=your_fixer_api_key

# GitHub Configuration
GITHUB_TOKEN=your_github_token

# Docker Configuration
DOCKER_USERNAME=your_docker_username
DOCKER_TOKEN=your_docker_token

# Internal API Keys
WAREHOUSING_API_KEY=your_warehousing_api_key
COURIER_API_KEY=your_courier_api_key
SOCIAL_COMMERCE_API_KEY=your_social_commerce_api_key

# Domain Configuration
API_BASE_URL=https://api.exalt-application-limited.com
FRONTEND_URL=https://exalt-application-limited.netlify.app
ADMIN_URL=https://admin.exalt-application-limited.com

# Monitoring
MONITORING_API_KEY=your_monitoring_api_key
ANALYTICS_API_KEY=your_analytics_api_key

# Firebase
FIREBASE_API_KEY=your_firebase_api_key

# Facebook
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# Deployment
RENDER_API_KEY=your_render_api_key
VERCEL_TOKEN=your_vercel_token
POSTMAN_API_KEY=your_postman_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://exalt-application-limited.netlify.app,https://admin.exalt-application-limited.com

# Maven Configuration
MAVEN_OPTS=-Xmx1024m -XX:MaxPermSize=256m
MAVEN_CENTRAL_URL=https://repo.maven.apache.org/maven2

# NPM Configuration
NPM_REGISTRY_URL=https://registry.npmjs.org
NPM_CACHE_FOLDER=.npm

# Build Configuration
BUILD_PARALLEL=true
BUILD_THREADS=4
TEST_PARALLEL=true
TEST_TIMEOUT=300000

# Code Quality
SONAR_HOST_URL=https://sonar.exalt-application-limited.com
SONAR_LOGIN_TOKEN=your-sonar-token
CODE_COVERAGE_THRESHOLD=80
